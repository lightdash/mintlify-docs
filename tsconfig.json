{
  "compilerOptions": {
    "allowJs": true,
    "jsx": "preserve",
    "paths": {
      "/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "ES2024"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "scripts/**/*.ts",
    "test/**/*.ts",
    "**/*.mdx",
    "snippets/**/*.jsx"
  ]
}
